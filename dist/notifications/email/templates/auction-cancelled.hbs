<html lang='en'>
  <head>
    <meta charset='utf-8' />
    <title>Your Auction Has Been Cancelled</title>
  </head>
  <body
    style='font-family: Arial, sans-serif; padding: 20px; color: #333; line-height: 1.6;'
  >
    <div
      style='max-width: 600px; margin: 0 auto; text-align: center; border: 1px solid #eee; padding: 30px; border-radius: 8px;'
    >
      <h2 style='color: #dc3545;'>Auction Cancelled ❌</h2>
      <p>Hello <strong>{{name}}</strong>,</p>
      <p>Your auction
        <strong>{{auctionTitle}}</strong>
        has been successfully cancelled.</p>

      <div
        style='background-color: #f8f9fa; padding: 20px; border-radius: 6px; margin: 25px 0; text-align: left;'
      >
        <p style='margin: 5px 0;'><strong>Auction:</strong> {{auctionTitle}}</p>
        <p style='margin: 5px 0; color: #dc3545;'><strong>Status:</strong>
          Cancelled</p>
      </div>

      <a
        href='{{auctionLink}}'
        style='display: inline-block; padding: 12px 24px; background-color: #6c757d; color: #ffffff; text-decoration: none; border-radius: 6px; margin: 15px 0; font-weight: bold;'
      >
        View Auction Details
      </a>

      <p style='font-size: 12px; color: #888; margin-top: 30px;'>Thank you for
        using Mazadak!</p>
    </div>
  </body>
</html>