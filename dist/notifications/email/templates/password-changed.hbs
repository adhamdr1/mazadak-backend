<html lang='en'>
  <head>
    <meta charset='utf-8' />
    <title>Security Alert: Password Changed</title>
  </head>
  <body
    style='font-family: Arial, sans-serif; padding: 20px; color: #333; line-height: 1.6;'
  >
    <div
      style='max-width: 600px; margin: 0 auto; text-align: center; border: 1px solid #eee; padding: 30px; border-radius: 8px;'
    >
      <h2 style='color: #dc3545;'>Security Alert 🔒</h2>
      <p>Hello <strong>{{name}}</strong>,</p>
      <p>This is an automated notification to inform you that your password for
        your
        <strong>Mazadak</strong>
        account was successfully changed on
        <strong>{{date}}</strong>.</p>

      <div
        style='background-color: #fff3cd; color: #856404; padding: 15px; border-radius: 6px; margin: 25px 0; border: 1px solid #ffeeba; text-align: left;'
      >
        <p style='margin: 0; font-weight: bold;'>Did you not make this change?</p>
        <p style='margin: 5px 0 0 0;'>If you did not request or perform this
          password change, please contact our support team immediately or reset
          your password to secure your account.</p>
      </div>

      <p style='font-size: 12px; color: #888; margin-top: 30px;'>If you
        performed this action, no further steps are required.</p>
    </div>
  </body>
</html>