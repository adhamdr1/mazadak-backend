<html lang='en'>
  <head>
    <meta charset='utf-8' />
    <title>Withdrawal Request Update</title>
  </head>
  <body
    style='font-family: Arial, sans-serif; padding: 20px; color: #333; line-height: 1.6;'
  >
    <div
      style='max-width: 600px; margin: 0 auto; text-align: center; border: 1px solid #eee; padding: 30px; border-radius: 8px;'
    >
      <h2 style='color: #dc3545;'>Withdrawal Request Update ❌</h2>
      <p>Hello <strong>{{name}}</strong>,</p>
      <p>We are writing to inform you that your withdrawal request could not be completed.</p>

      <div
        style='background-color: #fff5f5; border-left: 4px solid #dc3545; padding: 20px; border-radius: 6px; margin: 25px 0; text-align: left;'
      >
        <p style='margin: 5px 0;'><strong>Requested Amount:</strong> {{amount}} EGP</p>
        <p style='margin: 5px 0;'><strong>Status:</strong> Rejected</p>
        <p style='margin: 5px 0; color: #dc3545;'><strong>Reason:</strong> {{rejectionReason}}</p>
        <p style='margin: 10px 0 0; font-size: 13px; color: #666;'><em>Note: The requested amount has been fully unlocked and restored to your available wallet balance.</em></p>
      </div>

      {{#if walletLink}}
        <a
          href='{{walletLink}}'
          style='display: inline-block; padding: 12px 24px; background-color: #333333; color: #ffffff; text-decoration: none; border-radius: 6px; margin: 15px 0; font-weight: bold;'
        >
          Go to My Wallet
        </a>
      {{/if}}

      <p style='font-size: 12px; color: #888; margin-top: 30px;'>If you have questions regarding this decision, please reach out to our support team.</p>
    </div>
  </body>
</html>
