<html lang='en'>
  <head>
    <meta charset='utf-8' />
    <title>Withdrawal Request Received</title>
  </head>
  <body
    style='font-family: Arial, sans-serif; padding: 20px; color: #333; line-height: 1.6;'
  >
    <div
      style='max-width: 600px; margin: 0 auto; text-align: center; border: 1px solid #eee; padding: 30px; border-radius: 8px;'
    >
      <h2 style='color: #17a2b8;'>Withdrawal Request Received 📨</h2>
      <p>Hello <strong>{{name}}</strong>,</p>
      <p>We have received your withdrawal request from your Mazadak wallet.</p>

      <div
        style='background-color: #f8f9fa; padding: 20px; border-radius: 6px; margin: 25px 0; text-align: left;'
      >
        <p style='margin: 5px 0;'><strong>Requested Amount:</strong> {{amount}} EGP</p>
        <p style='margin: 5px 0;'><strong>Platform Fee:</strong> {{fee}} EGP</p>
        <p style='margin: 5px 0;'><strong>Net Amount:</strong> {{netAmount}} EGP</p>
        <p style='margin: 5px 0;'><strong>Payout Method:</strong> {{payoutMethod}}</p>
        <p style='margin: 5px 0;'><strong>Status:</strong> Pending Review</p>
        {{#if estimatedDelivery}}
          <p style='margin: 5px 0;'><strong>Estimated Delivery:</strong> {{estimatedDelivery}}</p>
        {{/if}}
      </div>

      {{#if withdrawalLink}}
        <a
          href='{{withdrawalLink}}'
          style='display: inline-block; padding: 12px 24px; background-color: #17a2b8; color: #ffffff; text-decoration: none; border-radius: 6px; margin: 15px 0; font-weight: bold;'
        >
          View Withdrawal Status
        </a>
      {{/if}}

      <p style='font-size: 12px; color: #888; margin-top: 30px;'>If you did not request this withdrawal, please contact support immediately.</p>
    </div>
  </body>
</html>
