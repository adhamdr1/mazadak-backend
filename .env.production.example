# ==========================================
# Mazadak Production Environment Variables Template
# Copy these into Render.com Dashboard -> Environment
# ==========================================

# Server Settings
PORT=3000
NODE_ENV=production
FRONTEND_URL=*

# Database (MongoDB Atlas M0 Free Cluster)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/mazadak?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/mazadak?retryWrites=true&w=majority

# Cache & Distributed Lock & PubSub (Upstash Redis with TLS)
REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379

# Message Broker (CloudAMQP RabbitMQ Free Little Lemur)
RABBITMQ_URL=amqps://<username>:<password>@<host>.lmq.cloudamqp.com/<vhost>

# Security & Authentication
JWT_SECRET=your_super_secret_production_jwt_key
JWT_REFRESH_SECRET=your_super_refresh_secret_production_key
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d
JWT_VERIFICATION_SECRET=your_verification_secret_key
JWT_VERIFICATION_EXPIRES_IN=1h

# Paymob Sandbox Configuration (Flash / Test Mode)
PAYMOB_SECRET_KEY=your_paymob_secret_key
PAYMOB_PUBLIC_KEY=your_paymob_public_key
PAYMOB_API_KEY=your_paymob_api_key
PAYMOB_HMAC_SECRET=your_paymob_hmac_secret
PAYMOB_INTEGRATION_IDS=5920296
PAYMOB_INTEGRATION_ID=5920296
PAYMOB_API_BASE_URL=https://accept.paymob.com

# Cloudinary (Media Uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_SECURE=false
SMTP_FROM=your_email@gmail.com

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Rate Limiting & Logs
STRICT_RATE_LIMIT_BLOCK_TTL=86400
LOG_LEVEL=info
LOG_DIR=logs
