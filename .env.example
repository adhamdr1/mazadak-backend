# Application Settings
PORT=3000
NODE_ENV=development

# Database Settings
# Note: MongoDB must be running with Replica Sets enabled for Transactions support.
MONGODB_URI=mongodb://localhost:27017/mazadak?replicaSet=rs0

# Caching & Rate Limiting
REDIS_URL=redis://localhost:6379

# Message Broker (Event-Driven Architecture)
RABBITMQ_URL=amqp://localhost:5672

# JWT Authentication
# Use a strong secret key in production
JWT_SECRET=your_super_secret_key
JWT_EXPIRATION=1d

# Cloudinary (For Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SMTP Settings (For Emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
# Note: Use App Password if you are using Gmail
SMTP_PASS=your_app_password

# Logging & APM Settings
LOG_LEVEL=info
LOG_DIR=logs
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
STRICT_RATE_LIMIT_BLOCK_TTL=86400

